formulas:
  Untitled: ""
views:
  - type: table
    name: Table
    filters:
      and:
        - category == "note"
        - file.tags.contains("ts")
    order:
      - file.name
      - description
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 298
  - type: cards
    name: View
